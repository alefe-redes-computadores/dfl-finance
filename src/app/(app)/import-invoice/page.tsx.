'use client'

import { useState, useRef, useEffect } from 'react'
import { useRouter } from 'next/navigation'
import { useAuth } from '@/lib/hooks/useAuth'
import { supabase } from '@/lib/supabase'
import {
  ChevronLeft, Upload, FileText, X, Check, AlertTriangle,
  Loader2, RefreshCw, File, FileSpreadsheet, FileArchive,
  Banknote, Calendar, Tag, AlertCircle, Sparkles, TrendingUp, TrendingDown
} from 'lucide-react'
import { useToast } from '@/contexts/ToastContext'
import ContextToggle, { useContext_ } from '@/components/ContextToggle'
import { formatCurrency } from '@/lib/utils'
import { format } from 'date-fns'
import { ptBR } from 'date-fns/locale'

// ============================================================
// SKELETON LOADER
// ============================================================
const PreviewSkeleton = () => (
  <div className="animate-pulse space-y-4">
    <div className="flex items-center justify-between">
      <div className="flex items-center gap-2">
        <div className="w-6 h-6 bg-gray-200 dark:bg-slate-700 rounded" />
        <div className="h-5 w-40 bg-gray-200 dark:bg-slate-700 rounded" />
        <div className="h-5 w-16 bg-gray-100 dark:bg-slate-700/50 rounded-full" />
      </div>
      <div className="h-8 w-24 bg-gray-200 dark:bg-slate-700 rounded-full" />
    </div>

    <div className="space-y-2">
      {[1, 2, 3, 4, 5].map((i) => (
        <div key={i} className="flex items-center gap-3 p-3 bg-gray-50 dark:bg-slate-700/50 rounded-xl">
          <div className="w-6 h-6 bg-gray-200 dark:bg-slate-600 rounded" />
          <div className="flex-1 space-y-2">
            <div className="h-3 w-40 bg-gray-200 dark:bg-slate-600 rounded" />
            <div className="h-2.5 w-24 bg-gray-100 dark:bg-slate-600/50 rounded" />
          </div>
          <div className="h-4 w-16 bg-gray-200 dark:bg-slate-600 rounded" />
        </div>
      ))}
    </div>

    <div className="flex gap-3">
      <div className="flex-1 h-12 bg-gray-200 dark:bg-slate-700 rounded-xl" />
      <div className="flex-1 h-12 bg-gray-200 dark:bg-slate-700 rounded-xl" />
    </div>
  </div>
)

export default function ImportInvoicePage() {
  const router = useRouter()
  const { user } = useAuth()
  const { context } = useContext_()
  const { showToast } = useToast()

  const [file, setFile] = useState<File | null>(null)
  const [transactions, setTransactions] = useState<any[]>([])
  const [loading, setLoading] = useState(false)
  const [loadingPulse, setLoadingPulse] = useState(false)
  const [importing, setImporting] = useState(false)
  const [importProgress, setImportProgress] = useState(0)
  const [importedCount, setImportedCount] = useState(0)
  const [errorCount, setErrorCount] = useState(0)
  const [status, setStatus] = useState<'idle' | 'uploading' | 'processing' | 'ready' | 'importing' | 'done' | 'error'>('idle')
  const [confidenceScore, setConfidenceScore] = useState<number | null>(null)

  const fileInputRef = useRef<HTMLInputElement>(null)
  const containerRef = useRef<HTMLDivElement>(null)

  // ============================================================
  // UPLOAD E PROCESSAMENTO
  // ============================================================
  const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const selectedFile = e.target.files?.[0]
    if (!selectedFile) return

    // Validar extensão
    const validExtensions = ['.pdf', '.ofx', '.qfx', '.csv']
    const fileExt = selectedFile.name.substring(selectedFile.name.lastIndexOf('.')).toLowerCase()
    if (!validExtensions.includes(fileExt)) {
      showToast('Por favor, selecione um arquivo PDF, OFX, QFX ou CSV.', 'warning')
      return
    }

    // Validar tamanho (max 10MB para faturas)
    if (selectedFile.size > 10 * 1024 * 1024) {
      showToast('Arquivo muito grande (máx 10MB).', 'warning')
      return
    }

    setFile(selectedFile)
    setStatus('uploading')
    setLoading(true)
    setLoadingPulse(true)

    try {
      // Upload para Supabase Storage
      const filePath = `invoices/${user?.id}/${Date.now()}_${selectedFile.name}`
      const { data: uploadData, error: uploadError } = await supabase.storage
        .from('invoices')
        .upload(filePath, selectedFile, {
          cacheControl: '3600',
          upsert: false,
        })

      if (uploadError) throw uploadError

      // Obter URL pública
      const { data: { publicUrl } } = supabase.storage
        .from('invoices')
        .getPublicUrl(filePath)

      // Processar com a IA
      setStatus('processing')
      showToast('Analisando fatura com IA...', 'info')

      const response = await fetch('/api/extract-invoice', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          fileUrl: publicUrl,
          filePath: filePath,
          fileType: fileExt.replace('.', ''),
        }),
      })

      const result = await response.json()

      if (!response.ok) {
        throw new Error(result.error || 'Falha no processamento da fatura')
      }

      // Processar resultado
      const extracted = result.data || result.transactions || []
      setTransactions(Array.isArray(extracted) ? extracted : [])
      setConfidenceScore(result.confidence || null)
      setStatus('ready')
      setLoading(false)
      setLoadingPulse(false)

      showToast(`${extracted.length} transações encontradas na fatura!`, 'success')
    } catch (error: any) {
      console.error('Erro no processamento:', error)
      showToast(`Erro: ${error.message || 'Falha ao processar fatura'}`, 'error')
      setStatus('error')
      setLoading(false)
      setLoadingPulse(false)
    }
  }

  // ============================================================
  // RESET
  // ============================================================
  const handleReset = () => {
    setFile(null)
    setTransactions([])
    setStatus('idle')
    setImportProgress(0)
    setImportedCount(0)
    setErrorCount(0)
    setConfidenceScore(null)
    if (fileInputRef.current) {
      fileInputRef.current.value = ''
    }
  }

  // ============================================================
  // IMPORTAR TRANSAÇÕES
  // ============================================================
  const handleImport = async () => {
    if (!user?.id) {
      showToast('Sessão expirada.', 'error')
      return
    }

    if (transactions.length === 0) {
      showToast('Nenhuma transação para importar.', 'warning')
      return
    }

    setImporting(true)
    setStatus('importing')
    setLoadingPulse(true)

    let successCount = 0
    let failCount = 0

    for (let i = 0; i < transactions.length; i++) {
      const tx = transactions[i]
      setImportProgress(((i + 1) / transactions.length) * 100)

      try {
        // Validar dados
        if (!tx.amount || !tx.description) {
          failCount++
          continue
        }

        // Buscar categoria (opcional)
        let categoryId = null
        if (tx.category) {
          const { data: catData } = await supabase
            .from('categories')
            .select('id')
            .eq('user_id', user.id)
            .eq('name', tx.category)
            .maybeSingle()
          if (catData) categoryId = catData.id
        }

        // Inserir transação
        const { error } = await supabase
          .from('transactions')
          .insert({
            user_id: user.id,
            context: context,
            type: tx.type || 'expense',
            amount: tx.amount,
            description: tx.description,
            date: tx.date || format(new Date(), 'yyyy-MM-dd'),
            status: 'done',
            affects_balance: true,
            category_id: categoryId,
            notes: tx.notes || null,
            receipt_url: tx.receipt_url || null,
            created_at: new Date().toISOString(),
            updated_at: new Date().toISOString(),
          })

        if (error) {
          console.error('Erro ao inserir:', error)
          failCount++
        } else {
          successCount++
        }
      } catch (err) {
        console.error('Erro na transação:', err)
        failCount++
      }
    }

    setImportedCount(successCount)
    setErrorCount(failCount)
    setStatus('done')
    setLoadingPulse(false)

    if (failCount === 0) {
      showToast(`${successCount} transações importadas com sucesso!`, 'success')
    } else {
      showToast(`${successCount} importadas, ${failCount} falhas.`, 'warning')
    }
  }

  // ============================================================
  // FORMATADORES
  // ============================================================
  const getStatusColor = (status: string) => {
    switch (status) {
      case 'idle': return 'text-gray-400 bg-gray-100 dark:bg-slate-700'
      case 'uploading': return 'text-blue-600 bg-blue-50 dark:bg-blue-900/20 dark:text-blue-400'
      case 'processing': return 'text-orange-600 bg-orange-50 dark:bg-orange-900/20 dark:text-orange-400'
      case 'ready': return 'text-teal-600 bg-teal-50 dark:bg-teal-900/20 dark:text-teal-400'
      case 'importing': return 'text-orange-600 bg-orange-50 dark:bg-orange-900/20 dark:text-orange-400'
      case 'done': return 'text-emerald-600 bg-emerald-50 dark:bg-emerald-900/20 dark:text-emerald-400'
      case 'error': return 'text-red-600 bg-red-50 dark:bg-red-900/20 dark:text-red-400'
      default: return 'text-gray-400 bg-gray-100 dark:bg-slate-700'
    }
  }

  const getStatusLabel = (status: string) => {
    switch (status) {
      case 'idle': return 'Aguardando arquivo'
      case 'uploading': return 'Enviando...'
      case 'processing': return 'Processando com IA...'
      case 'ready': return 'Pronto para importar'
      case 'importing': return 'Importando...'
      case 'done': return 'Importado com sucesso'
      case 'error': return 'Erro no processamento'
      default: return 'Desconhecido'
    }
  }

  const getFileIcon = (fileName: string) => {
    const ext = fileName.substring(fileName.lastIndexOf('.')).toLowerCase()
    switch (ext) {
      case '.pdf': return <FileText size={20} className="text-red-500" />
      case '.ofx': return <FileArchive size={20} className="text-orange-500" />
      case '.qfx': return <FileArchive size={20} className="text-orange-500" />
      case '.csv': return <FileSpreadsheet size={20} className="text-green-500" />
      default: return <File size={20} className="text-gray-500" />
    }
  }

  const getTypeIcon = (type: string) => {
    switch (type) {
      case 'income': return <TrendingUp size={16} className="text-emerald-500" />
      case 'expense': return <TrendingDown size={16} className="text-red-500" />
      default: return <Banknote size={16} className="text-gray-400" />
    }
  }

  const getTypeLabel = (type: string) => {
    switch (type) {
      case 'income': return 'Receita'
      case 'expense': return 'Despesa'
      default: return type
    }
  }

  // ============================================================
  // RENDER
  // ============================================================
  return (
    <div ref={containerRef} className="max-w-md mx-auto min-h-screen bg-[#f8f9fa] dark:bg-slate-900 pb-28 font-sans transition-colors duration-300">
      {/* Indicador de carregamento sutil */}
      {loadingPulse && (
        <div className="fixed top-20 right-4 z-50">
          <div className="w-3 h-3 bg-teal-500 rounded-full animate-pulse shadow-lg shadow-teal-500/50" />
        </div>
      )}

      {/* Header */}
      <div className="bg-white dark:bg-slate-800 px-4 pt-6 pb-4 shadow-sm border-b border-gray-50 dark:border-slate-700">
        <div className="flex items-center justify-between mb-4">
          <button onClick={() => router.push('/home')} className="p-2 -ml-2 text-gray-800 dark:text-gray-200 hover:text-gray-500 transition-colors">
            <ChevronLeft size={24} />
          </button>
          <h1 className="text-lg font-bold text-gray-800 dark:text-gray-100 flex items-center gap-2">
            <Sparkles size={20} className="text-teal-500" />
            Importar Fatura
          </h1>
          <div className="w-10" />
        </div>
        <ContextToggle />
      </div>

      <div className="px-4 pt-4 space-y-4">
        {/* Upload Area */}
        <div className="bg-white dark:bg-slate-800 rounded-[24px] p-6 shadow-sm border border-gray-100 dark:border-slate-700 text-center animate-in fade-in duration-300">
          {status === 'idle' || status === 'error' ? (
            <>
              <div className="w-20 h-20 bg-gray-50 dark:bg-slate-700 rounded-full flex items-center justify-center mx-auto mb-4">
                <FileText size={32} className="text-gray-400 dark:text-gray-500" />
              </div>
              <h3 className="font-bold text-gray-800 dark:text-gray-200 mb-2">Selecione a fatura</h3>
              <p className="text-sm text-gray-500 dark:text-gray-400 mb-6">
                Formatos suportados: PDF, OFX, QFX, CSV
                <br />
                Máx: 10MB
              </p>
              <input
                ref={fileInputRef}
                type="file"
                accept=".pdf,.ofx,.qfx,.csv"
                onChange={handleFileUpload}
                className="hidden"
                id="invoice-upload"
              />
              <label
                htmlFor="invoice-upload"
                className="inline-block bg-teal-700 text-white px-6 py-3 rounded-2xl font-bold hover:bg-teal-800 transition-colors cursor-pointer active:scale-95"
              >
                <Upload size={18} className="inline mr-2" />
                Selecionar Arquivo
              </label>
            </>
          ) : (
            <div className="space-y-4">
              <div className="flex items-center justify-between">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 bg-teal-50 dark:bg-teal-900/30 rounded-xl flex items-center justify-center">
                    {file ? getFileIcon(file.name) : <FileText size={20} className="text-teal-600" />}
                  </div>
                  <div className="text-left">
                    <p className="font-bold text-sm text-gray-800 dark:text-gray-200 truncate max-w-[180px]">
                      {file?.name || 'Arquivo carregado'}
                    </p>
                    <p className="text-[10px] text-gray-400">
                      {file ? (file.size / 1024).toFixed(1) + ' KB' : ''}
                    </p>
                  </div>
                </div>
                <div className={`text-[10px] font-bold px-3 py-1 rounded-full ${getStatusColor(status)} flex items-center gap-1`}>
                  {status === 'processing' && <Loader2 size={12} className="animate-spin" />}
                  {getStatusLabel(status)}
                </div>
              </div>

              {status === 'processing' && (
                <div className="space-y-3">
                  <div className="flex items-center justify-center gap-2 py-2">
                    <Loader2 size={20} className="animate-spin text-teal-600" />
                    <span className="text-sm text-gray-500">Analisando fatura com IA...</span>
                  </div>
                  <div className="w-full bg-gray-100 dark:bg-slate-700 rounded-full h-1.5 overflow-hidden">
                    <div className="h-full bg-teal-500 rounded-full animate-pulse w-3/4" />
                  </div>
                </div>
              )}

              {(status === 'ready' || status === 'done') && (
                <button
                  onClick={handleReset}
                  disabled={importing}
                  className="text-sm text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors disabled:opacity-50"
                >
                  <RefreshCw size={14} className="inline mr-1" />
                  Trocar arquivo
                </button>
              )}
            </div>
          )}
        </div>

        {/* Preview */}
        {(status === 'ready' || status === 'processing' || status === 'importing' || status === 'done') && (
          <div className="bg-white dark:bg-slate-800 rounded-[24px] p-5 shadow-sm border border-gray-100 dark:border-slate-700 animate-in fade-in duration-300">
            <div className="flex items-center justify-between mb-4">
              <div className="flex items-center gap-2">
                <Banknote size={18} className="text-teal-600" />
                <h3 className="font-bold text-sm text-gray-800 dark:text-gray-200">Transações Encontradas</h3>
                {status === 'ready' && (
                  <span className="text-[10px] text-gray-400 font-medium bg-gray-100 dark:bg-slate-700 px-2 py-0.5 rounded-full">
                    {transactions.length}
                  </span>
                )}
                {confidenceScore !== null && status === 'ready' && (
                  <span className={`text-[10px] font-medium px-2 py-0.5 rounded-full ${
                    confidenceScore > 0.8 ? 'bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400' :
                    confidenceScore > 0.5 ? 'bg-orange-50 text-orange-600 dark:bg-orange-900/30 dark:text-orange-400' :
                    'bg-red-50 text-red-600 dark:bg-red-900/30 dark:text-red-400'
                  }`}>
                    IA: {(confidenceScore * 100).toFixed(0)}%
                  </span>
                )}
              </div>
            </div>

            {status === 'processing' ? (
              <PreviewSkeleton />
            ) : transactions.length === 0 && status === 'ready' ? (
              <div className="text-center py-8">
                <AlertCircle size={32} className="text-gray-400 mx-auto mb-3" />
                <p className="text-gray-500 dark:text-gray-400 text-sm">Nenhuma transação encontrada na fatura.</p>
              </div>
            ) : (
              <div className="space-y-2 max-h-[400px] overflow-y-auto">
                {transactions.map((tx, index) => (
                  <div
                    key={index}
                    className="flex items-center gap-3 p-3 bg-gray-50 dark:bg-slate-700/50 rounded-xl hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors"
                  >
                    <div className="w-8 h-8 rounded-full bg-gray-100 dark:bg-slate-600 flex items-center justify-center">
                      {getTypeIcon(tx.type)}
                    </div>
                    <div className="flex-1 min-w-0">
                      <p className="text-[13px] font-medium text-gray-800 dark:text-gray-200 truncate">
                        {tx.description || 'Sem descrição'}
                      </p>
                      <div className="flex items-center gap-2 text-[10px] text-gray-400">
                        {tx.date && (
                          <span className="flex items-center gap-0.5">
                            <Calendar size={10} />
                            {format(new Date(tx.date), "dd/MM/yyyy", { locale: ptBR })}
                          </span>
                        )}
                        {tx.category && (
                          <span className="flex items-center gap-0.5">
                            <Tag size={10} />
                            {tx.category}
                          </span>
                        )}
                        <span className="text-[9px] uppercase font-bold text-gray-300 dark:text-gray-600">
                          {getTypeLabel(tx.type)}
                        </span>
                      </div>
                    </div>
                    <div className={`text-[14px] font-bold whitespace-nowrap ${
                      tx.type === 'income' ? 'text-emerald-600' : 'text-red-500'
                    }`}>
                      {tx.type === 'income' ? '+' : '-'}
                      {formatCurrency(tx.amount)}
                    </div>
                  </div>
                ))}
              </div>
            )}

            {(status === 'ready' || status === 'done') && transactions.length > 0 && (
              <div className="mt-4 flex flex-wrap gap-3">
                {status === 'ready' && (
                  <>
                    <button
                      onClick={handleImport}
                      disabled={importing}
                      className="flex-1 bg-teal-700 text-white py-3 rounded-xl font-bold hover:bg-teal-800 transition-colors disabled:opacity-50 flex items-center justify-center gap-2"
                    >
                      <Check size={18} />
                      Importar {transactions.length} transações
                    </button>
                    <button
                      onClick={handleReset}
                      disabled={importing}
                      className="px-4 py-3 rounded-xl border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-gray-400 font-bold hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors disabled:opacity-50"
                    >
                      <X size={18} />
                    </button>
                  </>
                )}
                {status === 'done' && (
                  <>
                    <button
                      onClick={() => router.push('/transactions')}
                      className="flex-1 bg-teal-700 text-white py-3 rounded-xl font-bold hover:bg-teal-800 transition-colors"
                    >
                      Ver transações
                    </button>
                    <button
                      onClick={handleReset}
                      className="flex-1 py-3 rounded-xl border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-gray-400 font-bold hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors"
                    >
                      Nova importação
                    </button>
                  </>
                )}
              </div>
            )}
          </div>
        )}

        {/* Progresso da Importação */}
        {status === 'importing' && (
          <div className="bg-white dark:bg-slate-800 rounded-[24px] p-5 shadow-sm border border-gray-100 dark:border-slate-700 animate-in fade-in duration-300">
            <div className="flex items-center justify-between mb-3">
              <span className="text-sm font-bold text-gray-700 dark:text-gray-300 flex items-center gap-2">
                <Loader2 size={16} className="animate-spin text-teal-600" />
                Importando...
              </span>
              <span className="text-sm text-gray-400">{Math.round(importProgress)}%</span>
            </div>
            <div className="w-full bg-gray-100 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
              <div className="h-full bg-teal-500 rounded-full transition-all duration-300" style={{ width: `${importProgress}%` }} />
            </div>
          </div>
        )}

        {/* Resultado */}
        {status === 'done' && (
          <div className="bg-white dark:bg-slate-800 rounded-[24px] p-5 shadow-sm border border-emerald-200 dark:border-emerald-800 animate-in fade-in duration-300">
            <div className="flex items-center gap-3 mb-4">
              <div className="w-10 h-10 bg-emerald-50 dark:bg-emerald-900/30 rounded-full flex items-center justify-center">
                <Check size={20} className="text-emerald-600" />
              </div>
              <div>
                <h3 className="font-bold text-gray-800 dark:text-gray-200">Importação concluída</h3>
                <p className="text-sm text-gray-500">
                  {importedCount} transações importadas
                  {errorCount > 0 && ` • ${errorCount} falhas`}
                </p>
              </div>
            </div>
          </div>
        )}

        {/* Ajuda */}
        <div className="bg-white dark:bg-slate-800 rounded-[24px] p-5 shadow-sm border border-gray-100 dark:border-slate-700">
          <h3 className="font-bold text-sm text-gray-800 dark:text-gray-200 mb-2 flex items-center gap-2">
            <Sparkles size={16} className="text-teal-500" />
            Como funciona
          </h3>
          <div className="text-xs text-gray-500 dark:text-gray-400 space-y-1">
            <p>1. <span className="font-bold text-gray-600 dark:text-gray-300">Envie o arquivo</span> da sua fatura (PDF ou OFX)</p>
            <p>2. <span className="font-bold text-gray-600 dark:text-gray-300">IA analisa</span> e extrai todas as transações</p>
            <p>3. <span className="font-bold text-gray-600 dark:text-gray-300">Revise</span> os dados extraídos</p>
            <p>4. <span className="font-bold text-gray-600 dark:text-gray-300">Importe</span> com um clique</p>
          </div>
        </div>
      </div>
    </div>
  )
}