# DFL Finance — contrato do runtime nativo
#
# Origem HTTPS do deployment Next/Vercel que hospeda:
# - /api/assistant/chat
# - /api/extract-invoice
# - /api/ocr-receipt
# - /_api/* quando consumido pelo cliente
#
# NÃO inclua barra final nem caminhos.
#
# Exemplo:
# NEXT_PUBLIC_DFL_SERVER_ORIGIN=https://finance.exemplo.com

NEXT_PUBLIC_DFL_SERVER_ORIGIN=https://SEU-DOMINIO-HTTPS
